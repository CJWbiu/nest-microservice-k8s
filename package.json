{
  "name": "nest-microservice-k8s",
  "version": "1.0.0",
  "private": true,
  "description": "Fenix Bookstore microservices on NestJS + Kubernetes",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' --filter '!@bookstore/web' build",
    "build:web": "pnpm --filter @bookstore/web build",
    "dev:account": "pnpm --filter @bookstore/account start:dev",
    "dev:security": "pnpm --filter @bookstore/security start:dev",
    "dev:warehouse": "pnpm --filter @bookstore/warehouse start:dev",
    "dev:payment": "pnpm --filter @bookstore/payment start:dev",
    "dev:gateway": "pnpm --filter @bookstore/gateway start:dev",
    "dev:web": "pnpm --filter @bookstore/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
